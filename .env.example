# Use Apple's MobileCLIP2-S2 model by default. Its checkpoint downloads on first classify request.
VISION_PROVIDER=mobileclip2
# Optional: set this to a pre-downloaded mobileclip2_s2.pt checkpoint path.
# MOBILECLIP2_CHECKPOINT=/absolute/path/mobileclip2_s2.pt

# Optional alternative provider. If VISION_PROVIDER=gemini, set a valid provider key.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Required for this demo backend. Use a long random value.
EDGECASE_ACCESS_TOKEN=replace-with-a-long-random-demo-token
RATE_LIMIT_REQUESTS_PER_MINUTE=12
